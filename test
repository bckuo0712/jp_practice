<!DOCTYPE html>
<html lang="zh-TW">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>日文50音 AI 練字王 - 加深版</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        html, body { position: fixed; overflow: hidden; width: 100%; height: 100%; touch-action: none; background-color: #f8fafc; }
        canvas { touch-action: none; background-color: white; border: 4px solid #1e293b; border-radius: 24px; box-shadow: 0 10px 30px rgba(0,0,0,0.1); }
        .active-mode { background-color: #3b82f6; color: white; transform: scale(1.05); }
        /* 加深底字的樣式 */
        #hint-text { 
            color: #e2e8f0; /* 調整為較深的灰色 (Slate-200) */
            opacity: 1;    /* 取消透明度，讓顏色實心顯示 */
            font-weight: 900; 
        }
    </style>
</head>
<body class="flex flex-col items-center p-4 font-sans">

    <div class="flex bg-gray-200 rounded-2xl p-1 mb-4 w-72 shadow-inner mt-4">
        <button id="btn-practice" onclick="setMode('practice')" class="flex-1 py-2 rounded-xl active-mode font-bold transition-all">練習版</button>
        <button id="btn-exam" onclick="setMode('exam')" class="flex-1 py-2 rounded-xl font-bold transition-all text-gray-500">實戰版</button>
    </div>

    <div class="text-center mb-2">
        <div id="target-romaji" class="text-3xl font-black text-blue-600 tracking-tighter uppercase">A</div>
        <div class="text-[10px] text-gray-500 font-bold tracking-widest mt-1">請同時書寫平假名與片假名</div>
    </div>

    <div class="relative mb-4">
        <canvas id="mainCanvas" width="320" height="320"></canvas>
        <div id="hint-text" class="absolute inset-0 flex items-center justify-center text-[9rem] pointer-events-none font-serif select-none">あア</div>
        
        <div id="loading" class="absolute top-4 right-4 hidden">
            <div class="animate-spin rounded-full h-6 w-6 border-4 border-blue-500 border-t-transparent"></div>
        </div>
    </div>

    <div id="status-msg" class="h-8 text-lg font-bold mb-4 text-slate-400">準備就緒</div>

    <div class="flex space-x-3 w-full max-w-[320px]">
        <button onclick="resetCanvas()" class="flex-1 bg-white border-2 border-gray-200 py-3 rounded-2xl font-bold text-gray-600">清除</button>
        <button onclick="showErrors()" class="px-4 bg-red-50 py-3 rounded-2xl font-bold text-red-500">錯誤本</button>
        <button onclick="nextQ()" class="flex-1 bg-slate-900 text-white py-3 rounded-2xl font-bold">跳過</button>
    </div>

    <div id="err-modal" class="fixed inset-0 bg-black/60 hidden flex items-center justify-center z-50 p-6 backdrop-blur-sm">
        <div class="bg-white rounded-3xl p-6 w-full max-w-sm max-h-[70vh] overflow-y-auto shadow-2xl">
            <div class="flex justify-between items-center mb-4 border-b pb-2">
                <span class="font-black text-xl text-slate-800">錯誤紀錄</span>
                <button onclick="closeErrors()" class="text-gray-400 text-2xl">✕</button>
            </div>
            <div id="err-list" class="space-y-2"></div>
            <button onclick="clearLocalStorage()" class="mt-4 w-full py-2 text-xs text-red-300">清空所有紀錄</button>
        </div>
    </div>

    <script>
        const kanaData = [
            { h: 'あ', k: 'ア', r: 'a' }, { h: 'い', k: 'イ', r: 'i' },
            { h: 'う', k: 'ウ', r: 'u' }, { h: 'え', k: 'エ', r: 'e' },
            { h: 'お', k: 'オ', r: 'o' }, { h: 'か', k: 'カ', r: 'ka' },
            { h: 'き', k: 'キ', r: 'ki' }, { h: 'く', k: 'ク', r: 'ku' },
            { h: 'け', k: 'ケ', r: 'ke' }, { h: 'こ', k: 'コ', r: 'ko' }
        ];

        let curIdx = 0;
        let mode = 'practice';
        let drawing = false;
        let timer = null;
        let strokes = [];

        const canvas = document.getElementById('mainCanvas');
        const ctx = canvas.getContext('2d');

        ctx.lineWidth = 7;
        ctx.lineCap = 'round';
        ctx.lineJoin = 'round';
        ctx.strokeStyle = '#1e293b';

        function render() {
            const q = kanaData[curIdx];
            document.getElementById('target-romaji').innerText = q.r;
            const hint = document.getElementById('hint-text');
            hint.innerText = q.h + q.k;
            // 只有練習模式顯示底字
            hint.style.visibility = (mode === 'practice') ? 'visible' : 'hidden';
            resetCanvas();
            msg("請書寫...", "text-slate-400");
        }

        function setMode(m) {
            mode = m;
            document.getElementById('btn-practice').className = `flex-1 py-2 rounded-xl font-bold transition-all ${m==='practice'?'active-mode':'text-gray-500'}`;
            document.getElementById('btn-exam').className = `flex-1 py-2 rounded-xl font-bold transition-all ${m==='exam'?'active-mode':'text-gray-500'}`;
            render();
        }

        function getXY(e) {
            const rect = canvas.getBoundingClientRect();
            const cx = e.touches ? e.touches[0].clientX : e.clientX;
            const cy = e.touches ? e.touches[0].clientY : e.clientY;
            return { x: cx - rect.left, y: cy - rect.top };
        }

        function start(e) {
            clearTimeout(timer);
            drawing = true;
            const p = getXY(e);
            ctx.beginPath();
            ctx.moveTo(p.x, p.y);
            strokes.push([[p.x], [p.y], []]);
        }

        function move(e) {
            if (!drawing) return;
            e.preventDefault();
            const p = getXY(e);
            ctx.lineTo(p.x, p.y);
            ctx.stroke();
            const last = strokes[strokes.length - 1];
            last[0].push(p.x);
            last[1].push(p.y);
        }

        function end() {
            if (!drawing) return;
            drawing = false;
            timer = setTimeout(apiRecognize, 500);
        }

        async function apiRecognize() {
            if (strokes.length === 0) return;
            document.getElementById('loading').classList.remove('hidden');
            msg("辨識中...", "text-blue-500");

            const q = kanaData[curIdx];
            const body = {
                options: "enable_pre_space",
                requests: [{
                    writing_guide: { writing_area_width: 320, writing_area_height: 320 },
                    ink: strokes,
                    language: "ja"
                }]
            };

            try {
                const res = await fetch('https://www.google.com.tw/inputtools/request?ime=handwriting&app=mobilesearch&cs=1&oe=UTF-8', {
                    method: 'POST',
                    body: JSON.stringify(body)
                });
                const data = await res.json();
                const candidates = data[1][0][1];

                const hitH = candidates.includes(q.h);
                const hitK = candidates.includes(q.k);

                if (hitH || hitK) {
                    msg("✅ 辨識正確！", "text-green-500");
                    setTimeout(nextQ, 800);
                } else {
                    msg("❌ 再試一次", "text-red-500");
                    recordError(q.h, q.k, q.r);
                }
            } catch (err) {
                msg("網路連線不穩", "text-orange-500");
            } finally {
                document.getElementById('loading').classList.add('hidden');
            }
        }

        function recordError(h, k, r) {
            let logs = JSON.parse(localStorage.getItem('jp_err_v3') || '[]');
            if (!logs.find(x => x.r === r)) {
                logs.push({ h, k, r, t: new Date().toLocaleTimeString() });
                localStorage.setItem('jp_err_v3', JSON.stringify(logs));
            }
        }

        function msg(t, c) {
            const m = document.getElementById('status-msg');
            m.innerText = t;
            m.className = `h-8 text-lg font-bold mb-4 ${c}`;
        }

        function resetCanvas() {
            ctx.clearRect(0, 0, canvas.width, canvas.height);
            strokes = [];
            clearTimeout(timer);
        }

        function nextQ() {
            curIdx = (curIdx + 1) % kanaData.length;
            render();
        }

        function showErrors() {
            const logs = JSON.parse(localStorage.getItem('jp_err_v3') || '[]');
            const list = document.getElementById('err-list');
            list.innerHTML = logs.length ? '' : '<p class="text-center text-gray-400">目前沒有紀錄！</p>';
            logs.reverse().forEach(x => {
                list.innerHTML += `<div class="flex justify-between p-3 bg-slate-50 rounded-2xl border border-slate-100">
                    <span class="text-2xl font-bold">${x.h}${x.k}</span>
                    <span class="text-slate-400 font-mono">${x.r}</span>
                </div>`;
            });
            document.getElementById('err-modal').classList.remove('hidden');
        }

        function closeErrors() { document.getElementById('err-modal').classList.add('hidden'); }
        function clearLocalStorage() { localStorage.removeItem('jp_err_v3'); showErrors(); }

        canvas.addEventListener('touchstart', start, { passive: false });
        canvas.addEventListener('touchmove', move, { passive: false });
        window.addEventListener('touchend', end);
        canvas.addEventListener('mousedown', start);
        canvas.addEventListener('mousemove', move);
        window.addEventListener('mouseup', end);

        render();
    </script>
</body>
</html>
